<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Real-Time Face Filter</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body {
      background: #0b0b0e;
      color: #ffffff;
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 100vh;
      padding: 12px;
    }
    .status-bar {
      width: 100%;
      max-width: 460px;
      background: #18181f;
      border: 1px solid #272732;
      padding: 10px 14px;
      border-radius: 12px;
      font-size: 0.85rem;
      color: #38bdf8;
      text-align: center;
      margin-bottom: 10px;
    }
    .stage {
      position: relative;
      width: 100%;
      max-width: 460px;
      aspect-ratio: 3 / 4;
      background: #14141a;
      border-radius: 18px;
      overflow: hidden;
      box-shadow: 0 12px 32px rgba(0,0,0,0.6);
      border: 1px solid #272732;
    }
    video, canvas {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      transform: scaleX(-1);
    }
    .preview-badge {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 56px;
      height: 56px;
      border-radius: 12px;
      border: 2px solid #38bdf8;
      object-fit: cover;
      background: #000;
      display: none;
      z-index: 10;
    }
    .controls {
      width: 100%;
      max-width: 460px;
      margin-top: 12px;
      background: #18181f;
      border: 1px solid #272732;
      padding: 14px;
      border-radius: 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .btn-group {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .btn {
      background: #2563eb;
      color: #fff;
      border: none;
      padding: 13px 10px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: opacity 0.2s;
    }
    .btn:active { opacity: 0.8; }
    .btn.camera-btn { background: #10b981; }
    input[type="file"] { display: none; }
    .slider-box {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      font-size: 0.85rem;
      color: #cbd5e1;
    }
    input[type="range"] { flex: 1; accent-color: #38bdf8; cursor: pointer; }
  </style>
</head>
<body>

  <div id="status" class="status-bar">⏳ Loading Face Engine... جاري تحميل المحرك</div>

  <div class="stage">
    <video id="webcam" autoplay playsinline muted></video>
    <canvas id="overlay"></canvas>
    <img id="facePreview" class="preview-badge" alt="Selected Face" />
  </div>

  <div class="controls">
    <div class="btn-group">
      <button id="cameraBtn" class="btn camera-btn">📷 Start Camera</button>
      <label for="faceInput" class="btn">🖼️ Upload Any Face</label>
      <input type="file" id="faceInput" accept="image/*" />
    </div>

    <div class="slider-box">
      <span>Opacity (الشفافية):</span>
      <input type="range" id="opacitySlider" min="0.1" max="1.0" step="0.05" value="0.95" />
    </div>
  </div>

  <script type="module">
    import { FaceLandmarker, FilesetResolver } from "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14";
    import Delaunator from "https://cdn.jsdelivr.net/npm/delaunator@5.0.0/+esm";

    const statusEl = document.getElementById("status");
    const video = document.getElementById("webcam");
    const canvas = document.getElementById("overlay");
    const faceInput = document.getElementById("faceInput");
    const cameraBtn = document.getElementById("cameraBtn");
    const opacitySlider = document.getElementById("opacitySlider");
    const facePreview = document.getElementById("facePreview");

    let faceLandmarker = null;
    let cameraActive = false;
    let processingStatic = false;
    let maskReady = false;
    let triangleCount = 0;
    let lastVideoTime = -1;

    // مصفوفة لتنعيم حركة الوجه ومنع الاهتزاز (Anti-Jitter Smoothing)
    const smoothedPositions = new Float32Array(468 * 2);
    let isFirstFrame = true;

    // 1. تهيئة WebGL للرسم السريع عبر GPU
    const gl = canvas.getContext("webgl", { alpha: true, premultipliedAlpha: false, antialias: true });

    const vsSource = `
      attribute vec2 aPosition;
      attribute vec2 aTexCoord;
      attribute float aAlpha;
      varying vec2 vTexCoord;
      varying float vAlpha;
      void main() {
        gl_Position = vec4(aPosition, 0.0, 1.0);
        vTexCoord = aTexCoord;
        vAlpha = aAlpha;
      }
    `;

    const fsSource = `
      precision mediump float;
      varying vec2 vTexCoord;
      varying float vAlpha;
      uniform sampler2D uSampler;
      uniform float uOpacity;
      void main() {
        vec4 color = texture2D(uSampler, vTexCoord);
        gl_FragColor = vec4(color.rgb, color.a * vAlpha * uOpacity);
      }
    `;

    function createShader(type, source) {
      const s = gl.createShader(type);
      gl.shaderSource(s, source);
      gl.compileShader(s);
      return s;
    }

    const program = gl.createProgram();
    gl.attachShader(program, createShader(gl.VERTEX_SHADER, vsSource));
    gl.attachShader(program, createShader(gl.FRAGMENT_SHADER, fsSource));
    gl.linkProgram(program);
    gl.useProgram(program);

    const posBuffer = gl.createBuffer();
    const uvBuffer = gl.createBuffer();
    const alphaBuffer = gl.createBuffer();
    const indexBuffer = gl.createBuffer();
    const texture = gl.createTexture();

    const aPosLoc = gl.getAttribLocation(program, "aPosition");
    const aTexLoc = gl.getAttribLocation(program, "aTexCoord");
    const aAlphaLoc = gl.getAttribLocation(program, "aAlpha");
    const uOpacityLoc = gl.getUniformLocation(program, "uOpacity");

    gl.enable(gl.BLEND);
    gl.blendFunc(gl.SRC_ALPHA, gl.ONE_MINUS_SRC_ALPHA);

    // 2. تحميل محرك MediaPipe Face Landmarker
    async function setupEngine() {
      try {
        const vision = await FilesetResolver.forVisionTasks(
          "https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm"
        );
        faceLandmarker = await FaceLandmarker.createFromOptions(vision, {
          baseOptions: {
            modelAssetPath: "https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task",
            delegate: "GPU"
          },
          runningMode: "VIDEO",
          numFaces: 1
        });
        statusEl.textContent = "✅ Ready! اضغط Start Camera ثم Upload Any Face";
      } catch (e) {
        statusEl.textContent = "❌ خطأ في تحميل المحرك، تأكد من اتصال الإنترنت.";
      }
    }
    setupEngine();

    // 3. تشغيل الكاميرا الأمامية بأداء سلس للهاتف والكمبيوتر
    cameraBtn.addEventListener("click", async () => {
      if (!faceLandmarker || cameraActive) return;
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: "user", width: { ideal: 720 }, height: { ideal: 960 } },
          audio: false
        });
        video.srcObject = stream;
        await video.play();
        canvas.width = video.videoWidth;
        canvas.height = video.videoHeight;
        gl.viewport(0, 0, canvas.width, canvas.height);

        cameraActive = true;
        cameraBtn.textContent = "🟢 Camera Active";
        statusEl.textContent = "📷 الكاميرا تعمل! الآن اضغط Upload Any Face لاختيار صورة.";
        requestAnimationFrame(renderLoop);
      } catch (err) {
        statusEl.textContent = "❌ يرجى السماح بصلاحية الكاميرا (تأكد من رابط HTTPS).";
      }
    });

    // 4. رفع أي صورة وجه وتجهيزها (مع ضغط الحجم لتعمل بسرعة على جميع الهواتف)
    faceInput.addEventListener("change", (e) => {
      const file = e.target.files[0];
      if (!file || !faceLandmarker) return;

      const rawImg = new Image();
      rawImg.onload = async () => {
        statusEl.textContent = "⏳ Analyzing Face... جاري استخراج ملامح الصورة";
        processingStatic = true;

        // توحيد أبعاد الصورة المرفوعة لتجنب بطء الهواتف ومشاكل WebGL
        const maxDim = 1024;
        let w = rawImg.width;
        let h = rawImg.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) { h = Math.round((h * maxDim) / w); w = maxDim; }
          else { w = Math.round((w * maxDim) / h); h = maxDim; }
        }
        const offCanvas = document.createElement("canvas");
        offCanvas.width = w;
        offCanvas.height = h;
        const ctx = offCanvas.getContext("2d");
        ctx.drawImage(rawImg, 0, 0, w, h);

        await faceLandmarker.setOptions({ runningMode: "IMAGE" });
        const res = faceLandmarker.detect(offCanvas);

        if (res.faceLandmarks && res.faceLandmarks.length > 0) {
          const pts = res.faceLandmarks[0].slice(0, 468);
          const uvs = new Float32Array(468 * 2);
          const coords = [];

          for (let i = 0; i < 468; i++) {
            uvs[i * 2] = pts[i].x;
            uvs[i * 2 + 1] = pts[i].y;
            coords.push([pts[i].x, pts[i].y]);
          }

          const delaunay = Delaunator.from(coords);
          const triangles = new Uint16Array(delaunay.triangles);
          triangleCount = triangles.length;

          // حساب المسافة من الحواف الخارجية لعمل تدرج ناعم (Soft Feathering)
          const hullSet = new Set(delaunay.hull);
          const hullPts = delaunay.hull.map(idx => coords[idx]);
          const alphas = new Float32Array(468);

          for (let i = 0; i < 468; i++) {
            if (hullSet.has(i)) {
              alphas[i] = 0.0;
            } else {
              let minDist = Infinity;
              const [px, py] = coords[i];
              for (const [hx, hy] of hullPts) {
                const d = Math.hypot(px - hx, py - hy);
                if (d < minDist) minDist = d;
              }
              // تنعيم الحافة تدريجياً
              alphas[i] = Math.min(1.0, minDist / 0.045);
            }
          }

          gl.bindBuffer(gl.ARRAY_BUFFER, uvBuffer);
          gl.bufferData(gl.ARRAY_BUFFER, uvs, gl.STATIC_DRAW);

          gl.bindBuffer(gl.ARRAY_BUFFER, alphaBuffer);
          gl.bufferData(gl.ARRAY_BUFFER, alphas, gl.STATIC_DRAW);

          gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer);
          gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, triangles, gl.STATIC_DRAW);

          gl.bindTexture(gl.TEXTURE_2D, texture);
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, offCanvas);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);

          facePreview.src = offCanvas.toDataURL();
          facePreview.style.display = "block";
          maskReady = true;
          isFirstFrame = true;
          statusEl.textContent = "✅ تم تركيب الفلتر بنجاح! حرك وجهك أمام الكاميرا.";
        } else {
          statusEl.textContent = "⚠️ لم يتم العثور على وجه واضح في هذه الصورة، جرب صورة أخرى.";
        }

        await faceLandmarker.setOptions({ runningMode: "VIDEO" });
        processingStatic = false;
      };
      rawImg.src = URL.createObjectURL(file);
    });

    // 5. حلقة التتبع والرسم في الوقت الفعلي (Real-Time 60 FPS Loop)
    function renderLoop() {
      if (!cameraActive) return;

      if (!processingStatic && video.currentTime !== lastVideoTime) {
        lastVideoTime = video.currentTime;
        const result = faceLandmarker.detectForVideo(video, performance.now());

        gl.clearColor(0, 0, 0, 0);
        gl.clear(gl.COLOR_BUFFER_BIT);

        if (maskReady && result.faceLandmarks && result.faceLandmarks.length > 0) {
          const live = result.faceLandmarks[0];
          const smoothingFactor = 0.7; // توازن مثالي بين السرعة وعدم الاهتزاز

          for (let i = 0; i < 468; i++) {
            const targetX = live[i].x * 2.0 - 1.0;
            const targetY = 1.0 - live[i].y * 2.0;

            if (isFirstFrame) {
              smoothedPositions[i * 2] = targetX;
              smoothedPositions[i * 2 + 1] = targetY;
            } else {
              smoothedPositions[i * 2] = smoothedPositions[i * 2] * (1 - smoothingFactor) + targetX * smoothingFactor;
              smoothedPositions[i * 2 + 1] = smoothedPositions[i * 2 + 1] * (1 - smoothingFactor) + targetY * smoothingFactor;
            }
          }
          isFirstFrame = false;

          gl.bindBuffer(gl.ARRAY_BUFFER, posBuffer);
          gl.bufferData(gl.ARRAY_BUFFER, smoothedPositions, gl.DYNAMIC_DRAW);
          gl.enableVertexAttribArray(aPosLoc);
          gl.vertexAttribPointer(aPosLoc, 2, gl.FLOAT, false, 0, 0);

          gl.bindBuffer(gl.ARRAY_BUFFER, uvBuffer);
          gl.enableVertexAttribArray(aTexLoc);
          gl.vertexAttribPointer(aTexLoc, 2, gl.FLOAT, false, 0, 0);

          gl.bindBuffer(gl.ARRAY_BUFFER, alphaBuffer);
          gl.enableVertexAttribArray(aAlphaLoc);
          gl.vertexAttribPointer(aAlphaLoc, 1, gl.FLOAT, false, 0, 0);

          gl.uniform1f(uOpacityLoc, parseFloat(opacitySlider.value));

          gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer);
          gl.drawElements(gl.TRIANGLES, triangleCount, gl.UNSIGNED_SHORT, 0);
        } else {
          isFirstFrame = true;
        }
      }

      requestAnimationFrame(renderLoop);
    }
  </script>
</body>
</html>
